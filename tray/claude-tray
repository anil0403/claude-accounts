        return head, vbox(panel, general, about)

    def switch(self, title, sub, on, cb):
        sw = Gtk.Switch(active=bool(on), valign=Gtk.Align.CENTER)
        sw.connect("notify::active", lambda w, _p: cb(w.get_active()))
        r = Gtk.Box(spacing=12)
        r.pack_start(two_lines(title, sub), True, True, 0)
        r.pack_end(sw, False, False, 0)
        return r

    # plugins and skills

    def extras(self):
        s, a = self.app.snap, self.app
        head = self.header("Plugins and skills", "Shared by every account")
        plugins = card(caption("PLUGINS", f"{sum(x['on'] for x in s['plugins'])} on"), spacing=2)
        for x in s["plugins"]:
            r = row("application-x-addon-symbolic", x["name"], lambda p=x["path"]: a.xdg_open(p),
                    " · ".join(t for t in (x["from"], x["version"]) if t))
            r.get_child().pack_end(pill("on" if x["on"] else "off", "green" if x["on"] else "grey"), False, False, 0)
            plugins.pack_start(r, False, False, 0)
        if not s["plugins"]:
            plugins.pack_start(lbl("None installed. In Claude Code: /plugin", "ct-small", "ct-dim"), False, False, 0)
        skills = card(caption("YOUR SKILLS"), spacing=2)
        for x in s["skills"]:
            skills.pack_start(row("starred-symbolic", x["name"], lambda p=x["path"]: a.xdg_open(p),
                                  x["about"] or short(x["path"])), False, False, 0)
        if not s["skills"]:
            skills.pack_start(lbl("None yet. Add a folder with a SKILL.md to ~/.claude/skills.", "ct-small", "ct-dim",
                                  wrap=True), False, False, 0)
        return head, vbox(plugins, skills)


# ---------- app ----------

class App(Gtk.Application):
    def __init__(self, show):
        super().__init__(application_id=APP_ID)
        self.show_at_start = show
        self.settings = load_settings()
        self.snap = {"names": accounts(), "use": {}, "folders": [], "sessions": [], "running": [],
                     "plugins": [], "skills": []}
        self.snapping = False
        self.ids, self.ids_for, self.ids_time, self.fetching_ids = {}, (), 0, False
        self.api = {}            # account -> {'blocked', 'strikes', 'error', 'busy', 'last'}
        self.stats, self.today, self.stats_busy, self.stats_time = Stats(), None, False, 0
        self.note = None         # (text, bad) after add / login / remove
        self.login = None        # LoginWindow while a login runs
        self.icon = self.dash = None
        self.alerts = Alerts()

    def do_activate(self):
        if self.dash:  # launched again: show the dashboard of the running tray
            return self.dash.popup()
        self.hold()
        install_css()
        self.dash = Dashboard(self)
        self.icon = PanelIcon(self)
        self.update_icon()
        self.tick()
        GLib.timeout_add_seconds(15, self.tick)
        if self.show_at_start:
            GLib.timeout_add(400, lambda: self.dash.popup() and False)

    # ----- data, gathered off the UI thread; results come back through GLib.idle_add -----

    def background(self, work, done):
        threading.Thread(target=lambda: GLib.idle_add(done, work()), daemon=True).start()

    def tick(self):
        if not self.snapping:
            self.snapping = True
            self.background(snapshot, self.got_snapshot)
        return True

    def got_snapshot(self, snap):
        self.snapping = False
        self.snap = snap
        now = time.time()
        names = snap["names"]
        if (tuple(names) != self.ids_for or now - self.ids_time > 1800) and not self.fetching_ids:
            self.fetch_identities(names)
        if now - self.stats_time >= 60 and not self.stats_busy:
            self.refresh_stats()
        if self.settings["api"]:
            for n in names:
                self.maybe_fetch_api(n, now)
        if self.settings["alerts"]:
            self.alerts.check(names, snap["use"], now)
        if self.dash.sig is None:  # build the home page once while hidden: loads the icons, so the first click is quick
            self.dash.render(force=True)
        self.changed()

    def changed(self):
        self.update_icon()
        self.dash.render()

    def fetch_identities(self, names=None):
        names = names or self.snap["names"]
        self.fetching_ids = True

        def done(ids):
            self.fetching_ids = False
            self.ids, self.ids_for, self.ids_time = ids, tuple(names), time.time()
            self.changed()
        self.background(lambda: {n: identity(n) for n in names}, done)

    def refresh_stats(self):
        self.stats_busy, self.stats_time = True, time.time()

        def done(s):
            self.stats_busy, self.today = False, s
            self.changed()
        self.background(self.stats.update, done)

    def maybe_fetch_api(self, name, now, force=False):
        a = self.api.setdefault(name, {"blocked": 0, "strikes": 0, "error": None, "busy": False, "last": 0})
        u = self.snap["use"].get(name) or {}
        if a["busy"] or now < a["blocked"] or "error" in self.ids.get(name, {}):
            return
        if not force and (now - u.get("updated", 0) < API_EVERY or now - a["last"] < API_EVERY):
            return
        a["busy"], a["last"] = True, now

        def work():
            feed, err, code, retry = fetch_api(name)
            if code == 401:  # let the official CLI refresh the token, then try once more
                identity(name)
                feed, err, code, retry = fetch_api(name)
            if feed:
                save_api_feed(name, feed)
            return feed, err, code, retry, usage(name)

        def done(res):
            feed, err, code, retry, fresh = res
            a["busy"] = False
            if feed:
                a["strikes"], a["error"] = 0, None
                self.snap["use"][name] = fresh
            else:
                a["error"] = err
                if code == 429:
                    a["strikes"] += 1
                    a["blocked"] = time.time() + (retry or min(BACKOFF * 2 ** (a["strikes"] - 1), 3600))
            self.changed()
        self.background(work, done)

    def api_note(self, name, u, now):
        a = self.api.get(name, {})
        if a.get("blocked", 0) > now:
            return f"Usage API paused until {clock(a['blocked'])} (rate-limited)"
        if a.get("error") and a["error"] != "no login token" and (not u or now - u.get("updated", 0) > STALE):
            return f"Usage API: {a['error']}"
        return None

    def signature(self, page, columns):
        """What a page shows; the page is rebuilt only when this changes. Times are in minutes."""
        s = self.snap
        now = time.time()
        return json.dumps([page, columns, s["names"], s["use"], s["folders"], s["sessions"], s["plugins"], s["skills"],
                           [(x["account"], x["name"], x["cwd"], x["busy"], x["id"]) for x in s["running"]],
                           self.ids, self.today, self.note, self.login and self.login.name, self.settings,
                           {n: self.api_note(n, s["use"].get(n), now) for n in s["names"]}, int(now // 60)],
                          sort_keys=True, default=str)

    # ----- panel -----

    def update_icon(self):
        now = time.time()
        names, use = self.snap["names"], self.snap["use"]
        shown = max(names, key=lambda n: (last_used(use.get(n)), n == "main"))  # the account in use
        u = use.get(shown)
        s, w = window(u, "session", now), window(u, "weekly", now)
        dim = not u or now - u.get("updated", 0) > STALE
        st, parts = self.settings, []
        if st["label_account"] and len(names) > 1:
            parts.append(shown)
        if s and st["label"] in ("session", "both"):
            parts.append(f"{s['pct']}%" + (f" · {w['pct']}%" if w and st["label"] == "both" else ""))
        if st["label_reset"] and s and s["resets"]:
            parts.append(f"↻{dur(s['resets'] - now)}")
        if st["label_cost"] and self.today:
            parts.append(f"${self.today['cost']:.2f}")
        tip = ["Claude"] + [f"{n}: " + (f"5h {a['pct']}% · 7d {b['pct']}%"
                                        if (a := window(use.get(n), "session", now)) and (b := window(use.get(n), "weekly", now))
                                        else "no usage yet") for n in names]
        self.icon.update(icon_path(s and s["pct"], dim), "  ".join(parts), "\n".join(tip))

    # ----- actions -----

    def set_setting(self, key, value):
        self.settings[key] = value
        save_settings(self.settings)
        if key == "api" and value:
            for n in self.snap["names"]:
                self.maybe_fetch_api(n, time.time())
        GLib.idle_add(self.changed)

    def set_autostart(self, on):
        try:
            set_autostart(on, os.path.realpath(__file__))
        except OSError as e:
            self.error(f"Could not change the autostart entry: {e}")

    def toggle_pin(self, key, item):
        def ident(p):
            return p["id"] if isinstance(p, dict) else p
        pins = self.settings[key]
        on = not any(ident(p) == ident(item) for p in pins)
        self.set_setting(key, [p for p in pins if ident(p) != ident(item)] + ([item] if on else []))

    def email(self, e):
        return mask_email(e) if self.settings["hide_emails"] else e

    def refresh_now(self):
        self.ids_time = 0  # identities are fetched again with the snapshot
        self.stats_time = 0
        if self.settings["api"]:
            now = time.time()
            for n in self.snap["names"]:
                u = self.snap["use"].get(n) or {}
                if now - u.get("updated", 0) >= 60:  # Claude Code's own numbers are fresher; keep them
                    self.maybe_fetch_api(n, now, force=True)
        self.tick()

    def copy(self, text):
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(text, -1)

    def xdg_open(self, target):
        self.dash.hide()
        try:
            subprocess.Popen(["xdg-open", target], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            self.error(f"Could not open {target}: {e}")

    def open(self, name, cwd, args=()):
        self.acc(["run", name, *args], cwd, hold=False)

    def acc(self, args, cwd, hold=True):
        self.dash.hide()
        exe = claude_acc()
        if not exe:
            return self.error("claude-acc was not found in ~/.local/bin. Run the installer again.")
        err = run_in_terminal(cwd, [exe, *args], hold=hold)
        if err:
            self.error(err)

    def choose_folder(self, name):
        self.dash.hide_for_dialog()
        d = Gtk.FileChooserDialog(title=f"Open Claude ({name}) in…", action=Gtk.FileChooserAction.SELECT_FOLDER)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.OK)
        d.set_current_folder(HOME)
        d.set_keep_above(True)
        if d.run() == Gtk.ResponseType.OK and d.get_filename():
            self.open(name, d.get_filename())
        d.destroy()

    def start_login(self, name, email=""):
        self.dash.hide_for_dialog()
        if self.login:
            return self.login.present()
        self.note = None
        self.login = LoginWindow(self, name, email)
        self.changed()

    def login_finished(self, name, ok, msg):
        self.login = None
        if not ok:
            self.note = (f"{name}: {msg}", True)
            return self.changed()

        def done(ids):
            self.ids, self.ids_for, self.ids_time = ids, tuple(ids), time.time()
            me = ids.get(name, {})
            twin = next((n for n, i in ids.items() if n != name and i.get("email") and i.get("email") == me.get("email")), None)
            if "error" in me:
                self.note = (f"{name} is still not logged in.", True)
            elif twin:
                self.note = (f"{name} is the same account as {twin}. Log in again with a different one.", True)
            else:
                self.note = (f"{name} logged in as {self.email(me['email'])}.", False)
            notify("Claude", self.note[0])
            self.changed()
        self.background(lambda: {n: identity(n) for n in accounts()}, done)

    def add_account(self):
        self.dash.hide_for_dialog()
        d = Gtk.Dialog(title="Add Claude account")
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Continue", Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        d.set_keep_above(True)
        box = d.get_content_area()
        box.set_spacing(8)
        box.set_border_width(12)
        intro = lbl("Pick a short name. You'll get a command <b>claude-&lt;name&gt;</b> that shares your history, "
                    "sessions, settings, plugins and skills. Your browser opens next so you can sign in.",
                    markup=True, wrap=True)
        intro.set_max_width_chars(50)
        box.add(intro)
        name_e = Gtk.Entry(activates_default=True, placeholder_text="name, e.g. work")
        mail_e = Gtk.Entry(activates_default=True, placeholder_text="email (optional, pre-fills the login page)")
        box.add(name_e)
        box.add(mail_e)
        d.show_all()
        while d.run() == Gtk.ResponseType.OK:
            name, email = name_e.get_text().strip().lower(), mail_e.get_text().strip()
            if re.fullmatch(r"[a-z0-9][a-z0-9-]{0,19}", name) and name not in ("main", "acc") and name not in accounts():
                d.destroy()
                return self.create_account(name, email)
            name_e.grab_focus()
            self.error(f"'{name}' can't be used: it must be new, 1–20 lowercase letters, digits or -, "
                       "and not 'main' or 'acc'.")
        d.destroy()

    def create_account(self, name, email):
        exe = claude_acc()
        if not exe:
            return self.error("claude-acc was not found in ~/.local/bin. Run the installer again.")
        r = subprocess.run([exe, "add", name, "--no-login"], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=60)
        if r.returncode != 0:
            return self.error((r.stderr or r.stdout).strip() or "claude-acc add failed")
        self.start_login(name, email)
        self.tick()

    def delete_session(self, x):
        self.dash.hide_for_dialog()
        if not self.confirm(f"Delete the session “{x['title']}”?",
                            "Its conversation moves to the trash, for all accounts.", "Delete"):
            return
        try:
            for path in transcripts(x["id"]):
                for f in (path, path[:-len(".jsonl")]):  # the transcript, and its folder of side files
                    if os.path.exists(f):
                        Gio.File.new_for_path(f).trash(None)
        except GLib.Error as e:
            return self.error(f"Could not delete the session: {e.message}")
        self.set_setting("pinned_sessions", [p for p in self.settings["pinned_sessions"] if p["id"] != x["id"]])
        self.tick()

    def remove_account(self, name):
        self.dash.hide_for_dialog()
        if not self.confirm(f"Remove account {name}?", f"This logs {name} out and deletes claude-{name}. "
                            "Shared history and sessions are kept.", "Remove"):
            return
        exe = claude_acc()

        def done(r):
            self.note = (f"Removed {name}.", False) if r.returncode == 0 else (f"Could not remove {name}.", True)
            self.ids.pop(name, None)
            self.tick()
        self.background(lambda: subprocess.run([exe, "rm", name, "--yes"], capture_output=True, text=True,
                                               stdin=subprocess.DEVNULL), done)

    def confirm(self, text, sub, verb):
        d = Gtk.MessageDialog(message_type=Gtk.MessageType.WARNING, text=text, secondary_text=sub)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, verb, Gtk.ResponseType.OK)
        d.get_widget_for_response(Gtk.ResponseType.OK).get_style_context().add_class("destructive-action")
        d.set_keep_above(True)
        ok = d.run() == Gtk.ResponseType.OK
        d.destroy()
        return ok

    def error(self, msg):
        self.dash.hide_for_dialog()
        d = Gtk.MessageDialog(message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.CLOSE, text=msg)
        d.set_keep_above(True)
        d.run()
        d.destroy()


def main():
    show = "--background" not in sys.argv[1:]
    if not sys.stderr.isatty():  # started from the menu or at login: keep errors and crashes
        os.makedirs(CACHE, exist_ok=True)
        sys.stderr = open(os.path.join(CACHE, "tray.log"), "a", buffering=1)
        if not os.environ.get("CLAUDE_TRAY_CHILD"):
            print(f"--- start {time.ctime()}", file=sys.stderr)
    import faulthandler
    faulthandler.enable(sys.stderr)
    if os.environ.get("CLAUDE_TRAY_CHILD"):
        return App(show).run([])
    # If GTK ever crashes, start the tray again rather than leave the panel without its icon.
    crashes = []
    while True:
        rc = subprocess.call([sys.executable, os.path.realpath(__file__), *sys.argv[1:]],
                             env={**os.environ, "CLAUDE_TRAY_CHILD": "1"})
        if -rc not in (signal.SIGSEGV, signal.SIGABRT, signal.SIGBUS):  # Quit, killed, already running
            return rc
        now = time.time()
        crashes = [t for t in crashes if now - t < 600] + [now]
        print(f"--- crashed (signal {-rc}); {'restarting' if len(crashes) <= 5 else 'giving up'}", file=sys.stderr)
        if len(crashes) > 5:
            return 1
        time.sleep(2)
        sys.argv[1:] = ["--background"]  # after a crash, come back quietly


if __name__ == "__main__":
    sys.exit(main())
