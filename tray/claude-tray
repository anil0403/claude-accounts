def dot(tone):
    d = Gtk.DrawingArea()
    d.set_size_request(10, 10)
    d.set_valign(Gtk.Align.CENTER)

    def draw(w, cr):
        cr.set_source_rgb(*hex_rgb(TONES[tone]))
        cr.arc(5, w.get_allocated_height() / 2, 4, 0, 2 * math.pi)
        cr.fill()
    d.connect("draw", draw)
    return d


def rounded(cr, x, y, w, h, r):
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def hbox(*children, spacing=8):
    b = Gtk.Box(spacing=spacing)
    for c in children:
        b.pack_start(c, False, False, 0)
    return b


def vbox(*children, spacing=10):
    b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)
    for c in children:
        if c is not None:
            b.pack_start(c, False, False, 0)
    return b


def pad(w, top, end, bottom, start):
    w.set_margin_top(top)
    w.set_margin_end(end)
    w.set_margin_bottom(bottom)
    w.set_margin_start(start)
    return w


