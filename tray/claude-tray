    # one account: open Claude with it, its projects and sessions, log in, remove

    def account(self, name):
        a, s, now = self.app, self.app.snap, time.time()
        if name not in s["names"]:
            return None
        ident = a.ids.get(name) or {}
        logged_in = "email" in ident
        cmd = "claude" if name == "main" else f"claude-{name}"
        tools = [pill(ident["plan"], plan_tone(ident["plan"]))] if ident.get("plan") else []
        head = self.header(name, a.email(ident["email"]) if logged_in else ident.get("error"), tools=tools)

        copy = Gtk.Button(label="Copy")
        copy.connect("clicked", lambda b: (a.copy(cmd), b.set_label("Copied")))
        cmd_row = Gtk.Box(spacing=8)
        cmd_row.pack_start(styled(lbl(cmd), "ct-code"), False, False, 0)
        cmd_row.pack_start(lbl("in any terminal", "ct-small", "ct-dim"), True, True, 0)
        cmd_row.pack_end(copy, False, False, 0)

        folders = s["folders"]
        actions = card(caption("OPEN CLAUDE"), spacing=2)
        if folders:
            actions.pack_start(row("media-playback-start-symbolic", "Continue the last session",
                                   lambda: a.open(name, folders[0], ["--continue"]), f"in {short(folders[0])}",
                                   tone="green"), False, False, 0)
        actions.pack_start(row("folder-open-symbolic", "New session in a folder…", lambda: a.choose_folder(name),
                               "Pick any project folder"), False, False, 0)
        actions.pack_start(row("user-home-symbolic", "New session in your home folder", lambda: a.open(name, HOME)),
                           False, False, 0)
        actions.pack_start(cmd_row, False, False, 6)

        body = vbox(actions, self.places(name, now))
        acct = card(caption("ACCOUNT"), spacing=2)
        login = row("changes-prevent-symbolic", "Log in again…" if logged_in else "Log in…",
                    lambda: a.start_login(name, ident.get("email", "")), "Opens your browser",
                    None if logged_in else "amber")
        login.set_sensitive(a.login is None)  # one browser login at a time
        acct.pack_start(login, False, False, 0)
        acct.pack_start(row("utilities-terminal-symbolic", "Log in in a terminal…",
                            lambda: a.acc(["login", name], HOME)), False, False, 0)
        if name != "main":
            rm = row("user-trash-symbolic", "Remove account…", lambda: a.remove_account(name),
                     f"Logs out and deletes {cmd}; shared history stays", "red")
            rm.set_sensitive(a.login is None)
            acct.pack_start(rm, False, False, 0)
        body.pack_start(acct, False, False, 0)
        return head, body

    def places(self, name, now):
        """Pinned sessions and projects, recent projects, recent sessions. Sessions are shared by all
        accounts, so any of them continues here with this account."""
        a, s = self.app, self.app.snap
        pins = a.settings
        running = {r["id"] for r in s["running"]}  # an open session can't be deleted
        fresh = {x["id"]: x for x in s["sessions"]}
        pinned_s = [fresh.get(x["id"], x) for x in pins["pinned_sessions"] if os.path.isdir(x.get("cwd", ""))]
        pinned_p = [p for p in pins["pinned"] if os.path.isdir(p)]
        box = card(spacing=2)

        def line(icon_name, title, sub, cb, pin_key, item, on, delete=None):
            r = Gtk.Box(spacing=2)
            r.pack_start(row(icon_name, title, cb, sub), True, True, 0)
            if delete:
                r.pack_end(tool("user-trash-symbolic", delete, "Delete this session", "ct-dim"), False, False, 0)
            r.pack_end(tool("view-pin-symbolic" if Gtk.IconTheme.get_default().has_icon("view-pin-symbolic")
                            else "starred-symbolic", lambda: a.toggle_pin(pin_key, item),
                            "Unpin" if on else "Pin to the top", "ct-pin", *(("ct-on", "ct-amber") if on else ())),
                       False, False, 0)
            box.pack_start(r, False, False, 0)

        def session(x, on):
            line("chat-symbolic", x["title"], short(x["cwd"]) + (f" · {ago(x['at'], now)}" if x.get("at") else ""),
                 lambda: a.open(name, x["cwd"], ["--resume", x["id"]]), "pinned_sessions",
                 {k: x[k] for k in ("id", "cwd", "title")}, on,
                 None if x["id"] in running else lambda: a.delete_session(x))

        def project(p, on):
            line("folder-symbolic", os.path.basename(p) or p, short(os.path.dirname(p)) or "/",
                 lambda: a.open(name, p), "pinned", p, on)

        if pinned_s or pinned_p:
            box.pack_start(caption("PINNED"), False, False, 4)
            for x in pinned_s:
                session(x, True)
            for p in pinned_p:
                project(p, True)
        projects = [f for f in s["folders"] if f != HOME and f not in pinned_p][:5]
        if projects:
            box.pack_start(caption("RECENT PROJECTS"), False, False, 4)
            for p in projects:
                project(p, False)
        ids = {x["id"] for x in pinned_s}
        sessions = [x for x in s["sessions"] if x["id"] not in ids]
        if sessions:
            box.pack_start(caption("RECENT SESSIONS", "resume with this account"), False, False, 4)
            for x in sessions:
                session(x, False)
        if not box.get_children():
            box.pack_start(lbl("No sessions yet.", "ct-small", "ct-dim"), False, False, 0)
        return box

