def heat(pct):
    return RED if pct >= 90 else AMBER if pct >= 70 else None


def tone_for(pct):
    return "red" if pct >= 90 else "amber" if pct >= 70 else "green"


def plan_tone(plan):
    return "purple" if plan.lower() in ("max", "team", "enterprise") else "blue" if plan.lower() == "pro" else "grey"


def plural(n, word):
    return f"{n} {word}{'s' * (n != 1)}"


def esc(s):
    return GLib.markup_escape_text(str(s))


def hex_rgb(h):
    return tuple(int(h[i:i + 2], 16) / 255 for i in (1, 3, 5))


TINT = [0.2, 0.2, 0.2, 1]  # the glass's colour: the theme's menu background (install_css sets it)


def install_css():
    """The colours of the theme's menus, as the old panel menu had them: their background (the glass
    tint), their text and their highlight. Badge colours are picked for that shade."""
    menu, mi = Gtk.Menu(), Gtk.MenuItem(label="x")
    menu.append(mi)
    ctx = menu.get_style_context()
    fg = ctx.get_color(Gtk.StateFlags.NORMAL)
    bg = ctx.get_property("background-color", Gtk.StateFlags.NORMAL)
    hover = mi.get_style_context()
    hover.set_state(Gtk.StateFlags.PRELIGHT)
    sel = hover.get_property("background-color", Gtk.StateFlags.PRELIGHT)
    sel_fg = hover.get_color(Gtk.StateFlags.PRELIGHT)
    menu.destroy()
    dark = 0.299 * fg.red + 0.587 * fg.green + 0.114 * fg.blue > 0.5
    if bg.alpha < 0.05:  # the theme draws menus in a parent node; use a plain shade
        bg = Gdk.RGBA(*((0.2, 0.2, 0.2) if dark else (0.97, 0.97, 0.98)), 1)
    if sel.alpha < 0.5:
        found, c = Gtk.Window().get_style_context().lookup_color("theme_selected_bg_color")
        sel, sel_fg = (c if found else Gdk.RGBA(0.03, 0.38, 0.95, 1)), Gdk.RGBA(1, 1, 1, 1)
    TINT[:3] = bg.red, bg.green, bg.blue

    def rgb(c):
        return f"rgb({int(c.red * 255)},{int(c.green * 255)},{int(c.blue * 255)})"
    css = "".join(f"@define-color {k} {rgb(v)};\n" for k, v in
                  (("ct_bg", bg), ("ct_fg", fg), ("ct_sel", sel), ("ct_sel_fg", sel_fg))) + CSS
    text = TEXT_ON_DARK if dark else TEXT_ON_LIGHT
    for t, base in TONES.items():
        css += (f".ct-{t} {{ color: {text[t]}; }}\n"
                f".ct-pill.ct-{t}, .ct-banner.ct-{t} {{ background-color: alpha({base}, 0.2); }}\n"
                f".ct-icon.ct-{t} {{ background-color: {base}; color: #ffffff; }}\n")
    p = Gtk.CssProvider()
    p.load_from_data(css.encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


# ---------- glass ----------

BLUR = 8  # screen pixels per backdrop pixel


def grab_backdrop():
    """The screen, shrunk: drawn back enlarged it is blurred, the frosted glass behind the cards. Grabbed as
    the window opens (Muffin has no blur-behind for client windows). None where the screen can't be read."""
    # ponytail: a still, so what moves behind the open window doesn't; a compositor blur would fix that
    root = Gdk.get_default_root_window()
    w, h = root.get_width(), root.get_height()
    pb = Gdk.pixbuf_get_from_window(root, 0, 0, w, h)
    if not pb:
        return None
    for d in (4, 4 * BLUR, BLUR):  # down in two steps, then half way back up: no blocks
        pb = pb.scale_simple(max(1, w // d), max(1, h // d), GdkPixbuf.InterpType.BILINEAR)
    surface = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)  # enlarged once, not on every redraw
    cr = cairo.Context(surface)
    cr.scale(w / pb.get_width(), h / pb.get_height())
    Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
    cr.paint()
    return surface


def tile(cr, x, y, width, height, radius, fill):
    """A card: fill, a sheen fading down from the top, a thin light edge."""
    cr.save()
    rounded(cr, x, y, width, height, radius)
    cr.clip()
    cr.set_source_rgba(*fill)
    cr.paint()
    sheen = cairo.LinearGradient(0, y, 0, y + min(height, 160))
    sheen.add_color_stop_rgba(0, 1, 1, 1, 0.09)
    sheen.add_color_stop_rgba(1, 1, 1, 1, 0)
    cr.set_source(sheen)
    cr.paint()
    rounded(cr, x + 0.5, y + 0.5, width - 1, height - 1, radius)
    cr.set_source_rgba(1, 1, 1, 0.16)
    cr.set_line_width(1)
    cr.stroke()
    cr.restore()


def icon_path(pct, dim):
    """A 22px ring gauge as an SVG file (a new name per state so the panel doesn't serve a cached one)."""
    os.makedirs(CACHE, exist_ok=True)
    col = GREY if pct is None or dim else heat(pct) or GREEN
    key = "none" if pct is None else f"{min(pct, 100)}{'-dim' if dim else ''}"
    path = os.path.join(CACHE, f"ring-{key}.svg")
    if not os.path.exists(path):
        c, r = 11, 8
        arc = ""
        if pct:
            frac = min(pct, 100) / 100
            if frac >= 1:
                arc = f'<circle cx="{c}" cy="{c}" r="{r}" fill="none" stroke="{col}" stroke-width="3"/>'
            else:
                a = frac * 2 * math.pi
                x, y = c + r * math.sin(a), c - r * math.cos(a)
                arc = (f'<path d="M {c} {c - r} A {r} {r} 0 {1 if frac > 0.5 else 0} 1 {x:.2f} {y:.2f}" '
                       f'fill="none" stroke="{col}" stroke-width="3" stroke-linecap="round"/>')
        svg = (f'<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22">'
               f'<circle cx="{c}" cy="{c}" r="{r}" fill="none" stroke="{GREY}" stroke-opacity="0.45" stroke-width="3"/>'
               f'{arc}<circle cx="{c}" cy="{c}" r="2.5" fill="{col}"/></svg>')
        with open(path + ".tmp", "w") as f:
            f.write(svg)
        os.replace(path + ".tmp", path)
    return path


