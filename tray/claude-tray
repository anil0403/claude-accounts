class Meter(Gtk.Box):
    """One usage window: caption and time to the reset, a bar with a pace tick, the % under it."""

    def __init__(self, caption_text, w, length, now, dim):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=9)
        self.w, self.dim, self.pace = w, dim, pace(w, length, now)
        top = Gtk.Box(spacing=8)
        top.pack_start(lbl(caption_text, "ct-caption"), False, False, 0)
        when = f"Resets in {dur(w['resets'] - now)}" if w["resets"] else "Reset time unknown"
        top.pack_end(lbl(when, "ct-small", "ct-dim", xalign=1), False, False, 0)
        self.pack_start(top, False, False, 0)
        bar = Gtk.DrawingArea()
        bar.set_size_request(-1, 12)
        bar.connect("draw", self.draw)
        if self.pace is not None:
            diff = w["pct"] - self.pace
            bar.set_tooltip_text(f"{round(diff)}% over pace: at this rate you hit the limit early" if diff > 5 else
                                 "Under pace" if diff < -5 else "On pace")
        self.pack_start(bar, False, False, 0)
        self.pack_start(lbl(f"{w['pct']}%", "ct-pct", None if dim else f"ct-{tone_for(w['pct'])}", xalign=1),
                        False, False, 0)

    def draw(self, widget, cr):
        width, h = widget.get_allocated_width(), widget.get_allocated_height()
        fg = widget.get_style_context().get_color(widget.get_state_flags())
        y, bh = (h - 8) / 2, 8
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.16)
        rounded(cr, 0, y, width, bh, 4)
        cr.fill()
        if self.w["pct"] > 0:
            cr.set_source_rgb(*hex_rgb(GREY if self.dim else TONES[tone_for(self.w["pct"])]))
            rounded(cr, 0, y, max(8, width * self.w["pct"] / 100), bh, 4)
            cr.fill()
        if self.pace is not None:
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.9)
            rounded(cr, width * self.pace / 100 - 1, 0, 2, h, 1)
            cr.fill()
        return False


