        a, s, now = self.app, self.app.snap, time.time()
        if name not in s["names"]:
            return None
        pins = a.settings
        pin_icon = "view-pin-symbolic" if Gtk.IconTheme.get_default().has_icon("view-pin-symbolic") else "starred-symbolic"
        running = {r["id"] for r in s["running"]}  # an open session can't be deleted
        fresh = {x["id"]: x for x in s["sessions"]}
        pinned_s = [fresh.get(x["id"], x) for x in pins["pinned_sessions"] if os.path.isdir(x.get("cwd", ""))]
        pinned_p = [p for p in pins["pinned"] if os.path.isdir(p)]

        def line(icon_name, title, sub, cb, key, item, on, delete=None):
            end = [tool("user-trash-symbolic", delete, "Delete this session", "ct-trash", "ct-red")] if delete else []
            end.append(tool(pin_icon, lambda: a.toggle_pin(key, item), "Unpin" if on else "Pin: keep at the top",
                            "ct-pin", "ct-amber" if on else None))
            return self.row(icon_name, title, cb, sub, end=end)

        def session(x, on):
            return line("chat-symbolic", x["title"], short(x["cwd"]) + (f" · {ago(x['at'], now)}" if x.get("at") else ""),
                        lambda: a.open(name, x["cwd"], ["--resume", x["id"]]), "pinned_sessions",
                        {k: x[k] for k in ("id", "cwd", "title")}, on,
