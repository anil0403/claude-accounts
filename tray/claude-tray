class LoginWindow(Gtk.Window):
    """`claude auth login` without a terminal: it opens the browser itself and finishes on its own once
    you approve (the browser link points back to localhost). A code box is there for when it doesn't."""

    def __init__(self, app, name, email):
        super().__init__(title=f"Log in: {name}")
        self.app, self.name = app, name
        self.out, self.states, self.cancelled = [], set(), None
        self.set_keep_above(True)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(16)
        self.set_default_size(460, -1)
        self.connect("delete-event", lambda *_: self.hide() or True)

        os.makedirs(CACHE, exist_ok=True)
        self.url_file = os.path.join(CACHE, f"login-{name}.url")
        hook = os.path.join(CACHE, "browser-hook")
        with open(hook, "w") as f:  # records the link Claude opens, then opens it as usual
            f.write('#!/bin/sh\nprintf "%s" "$1" > "$CLAUDE_TRAY_URL_FILE"\n'
                    'command -v xdg-open >/dev/null && exec xdg-open "$1"\n')
        os.chmod(hook, 0o755)
        try:
            os.remove(self.url_file)
        except OSError:
            pass
        env = dict(account_env(name), BROWSER=hook, CLAUDE_TRAY_URL_FILE=self.url_file)
        args = [shutil.which("claude") or "claude", "auth", "login"] + (["--email", email] if email else [])
        self.proc = subprocess.Popen(args, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, text=True, start_new_session=True)
        threading.Thread(target=self.reader, daemon=True).start()
        GLib.timeout_add_seconds(LOGIN_TIMEOUT, self.timeout)

        box = vbox()
        self.add(box)
        box.pack_start(lbl(f"<b>Your browser opened claude.ai.</b>\nSign in as the account you want for "
                           f"<b>{esc(name)}</b> and click <b>Authorize</b>. This window closes by itself "
                           "when the login finishes.", markup=True, wrap=True), False, False, 0)
        box.pack_start(lbl('<small>Browser already signed in as another account? Sign out there first, or '
                           'copy the link and open it in a private window (Ctrl+Shift+N or Ctrl+Shift+P).</small>',
                           markup=True, wrap=True), False, False, 0)
        copy = Gtk.Button(label="Copy link")
        copy.connect("clicked", self.copy_link)
        again = Gtk.Button(label="Open browser again")
        again.connect("clicked", lambda *_: self.link() and subprocess.Popen(["xdg-open", self.link()]))
        box.pack_start(hbox(copy, again, spacing=6), False, False, 0)

        exp = Gtk.Expander(label="The browser showed a code instead?")
        cbox = vbox(spacing=6)
        cbox.set_margin_top(6)
        self.entry = Gtk.Entry(visibility=False, placeholder_text="paste the code here (Ctrl+V)")
        self.entry.set_invisible_char("*")
        self.entry.connect("activate", self.submit)
        cbox.pack_start(self.entry, False, False, 0)
        crow = Gtk.Box(spacing=6)
        show = Gtk.CheckButton(label="Show code")
        show.connect("toggled", lambda b: self.entry.set_visibility(b.get_active()))
        send = Gtk.Button(label="Log in with code")
        send.connect("clicked", self.submit)
        crow.pack_start(show, False, False, 0)
        crow.pack_end(send, False, False, 0)
        cbox.pack_start(crow, False, False, 0)
        self.hint = lbl("", markup=True, wrap=True)
        cbox.pack_start(self.hint, False, False, 0)
        exp.add(cbox)
        box.pack_start(exp, False, False, 0)

        bottom = Gtk.Box(spacing=6)
        self.status = lbl('<small><span alpha="65%">Waiting for the browser…</span></small>', markup=True)
        cancel = Gtk.Button(label="Cancel login")
        cancel.connect("clicked", lambda *_: self.cancel())
        bottom.pack_start(self.status, True, True, 0)
        bottom.pack_end(cancel, False, False, 0)
        box.pack_start(bottom, False, False, 0)
        self.show_all()

    def reader(self):
        for line in self.proc.stdout:
            self.out.append(line)
            self.states.update(re.findall(r"state=([A-Za-z0-9_-]+)", line))
        rc = self.proc.wait()
        GLib.idle_add(self.finished, rc)

    def link(self):
        try:
            with open(self.url_file) as f:
                return f.read().strip()
        except OSError:
            m = re.search(r"https://\S+?(?=\x1b|\s|$)", "".join(self.out))
            return m.group(0) if m else None

    def copy_link(self, *_):
        url = self.link()
        if url:
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(url, -1)
            self.status.set_markup("<small>Link copied. Paste it into a private window.</small>")
        else:
            self.status.set_markup(f'<small><span foreground="{AMBER}">No link yet, try again in a moment.</span></small>')

    def submit(self, *_):
        code = re.sub(r"\s+", "", self.entry.get_text())
        half = len(code) // 2
        if len(code) % 2 == 0 and code and code[:half] == code[half:]:
            code = code[:half]  # pasted twice
        if "#" not in code:
            return self.say("That isn't a login code (it has no '#'). Copy it again from the browser.")
        self.states.update(re.findall(r"state=([A-Za-z0-9_-]+)", self.link() or ""))
        if self.states and code.split("#", 1)[1] not in self.states:
            return self.say("That code is from a different login attempt (an older browser tab). "
                            "Use the tab this login opened, or click Open browser again.")
        try:
            self.proc.stdin.write(code + "\n")
            self.proc.stdin.flush()
        except (OSError, ValueError):
            return self.say("The login already ended.")
        self.say("Checking the code…", ok=True)

    def say(self, text, ok=False):
        self.hint.set_markup(f'<small><span foreground="{BLUE if ok else AMBER}">{esc(text)}</span></small>')

    def timeout(self):
        if self.proc.poll() is None:
            self.cancel("Login timed out.")
        return False

    def cancel(self, why="Login cancelled."):
        self.cancelled = why
        if self.proc.poll() is None:
            self.proc.terminate()

    def finished(self, rc):
        self.destroy()
        msg = self.cancelled
        if rc != 0 and not msg:
            last = [x.strip() for x in self.out if x.strip()]
            msg = re.sub(r".*prompted > ", "", last[-1]) if last else "Login failed."
        self.app.login_finished(self.name, rc == 0 and not self.cancelled, msg)
        return False


# ---------- panel icon ----------

class PanelIcon:
    """The panel icon, through whatever the panel speaks: XApp's status icon (Cinnamon, MATE, Xfce),
    an AppIndicator (KDE, GNOME with the AppIndicator extension, ...) or GTK's tray icon (other X11
    panels). XApp and GTK report clicks, so the dashboard toggles; an AppIndicator only shows a
    menu, so that menu opens it (a middle click does too)."""

    SIDES = {Gtk.PositionType.TOP: "top", Gtk.PositionType.BOTTOM: "bottom",
             Gtk.PositionType.LEFT: "left", Gtk.PositionType.RIGHT: "right"}

    def __init__(self, app):
        self.app = app
        desk = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
        if XApp and (any(d in desk for d in ("cinnamon", "mate", "xfce")) or not Indicator):
            self.kind = "xapp"
            self.icon = XApp.StatusIcon()
            self.icon.set_name("claude-tray")
            self.icon.connect("button-release-event", self.xapp_clicked)
        elif Indicator:
            self.kind = "indicator"
            self.icon = Indicator.Indicator.new("claude-accounts", "claude-accounts",
                                                Indicator.IndicatorCategory.APPLICATION_STATUS)
            self.icon.set_status(Indicator.IndicatorStatus.ACTIVE)
            self.icon.set_title("Claude Accounts")
            menu = Gtk.Menu()
            for text, cb in (("Open Claude Accounts", lambda: app.dash.popup()), ("Refresh now", app.refresh_now),
                             (None, None), ("Quit", app.quit)):
                it = Gtk.SeparatorMenuItem() if text is None else Gtk.MenuItem(label=text)
                if cb:
                    it.connect("activate", lambda _it, cb=cb: cb())
                menu.append(it)
            menu.show_all()
            self.icon.set_menu(menu)
            self.icon.set_secondary_activate_target(menu.get_children()[0])
            self.menu = menu  # the indicator keeps no reference of its own
        else:
            self.kind = "gtk"
            self.icon = Gtk.StatusIcon()
            self.icon.set_title("Claude Accounts")
            self.icon.connect("activate", lambda *_: app.dash.toggle(self.gtk_anchor()))
            self.icon.connect("popup-menu", lambda *_: app.dash.toggle(self.gtk_anchor()))

    def xapp_clicked(self, icon, x, y, button, t, position):
        if button in (Gdk.BUTTON_PRIMARY, Gdk.BUTTON_SECONDARY):
            size = icon.get_icon_size() or 24
            side = self.SIDES.get(position, "bottom")
            self.app.dash.toggle((x + size // 2, y, side) if side in ("top", "bottom") else (x, y, side), t)

    def gtk_anchor(self):
        ok, _screen, area, _orient = self.icon.get_geometry()
        if not ok:
            return None
        mon = Gdk.Display.get_default().get_monitor_at_point(area.x, area.y).get_geometry()
        cx = area.x + area.width // 2
        return (cx, area.y, "bottom") if area.y > mon.y + mon.height // 2 else (cx, area.y + area.height, "top")

    def update(self, path, text, tip):
        if self.kind == "xapp":
            self.icon.set_icon_name(path)
            self.icon.set_label(text)
            self.icon.set_tooltip_text(tip)
        elif self.kind == "indicator":
            self.icon.set_icon_full(path, "Claude usage")
            self.icon.set_label(text, "")
        else:
            self.icon.set_from_file(path)
            self.icon.set_tooltip_text(tip)

    def shows_text(self):
        return self.kind != "gtk"


def pointer_anchor():
    _screen, x, y = Gdk.Display.get_default().get_default_seat().get_pointer().get_position()
    mon = Gdk.Display.get_default().get_monitor_at_point(x, y).get_geometry()
    return x, y, "bottom" if y > mon.y + mon.height // 2 else "top"


# ---------- dashboard ----------

class Level:
    """One menu of the cascade: the dashboard itself (depth 0), an account's menu, its Recent Projects or
    Plugins and Skills, or Settings. widget is what holds it; view is the scrolled window it shows in."""

    def __init__(self, key, widget, view, own, items, tiles):
        self.key, self.widget, self.view, self.own, self.items, self.tiles = key, widget, view, own, items, tiles


class Dashboard(Gtk.Window):
    """What the panel icon opens, drawn as the old panel menu was: cards of frosted glass over the desktop,
    accounts on the left; today, the best account, the running sessions and the actions on the right.
    An account opens its menu beside it (and that menu its Recent Projects or Plugins and Skills one
    further out), when pointed at or clicked, as submenus do; Settings opens over the accounts. It is one
    window that grows to hold what is open, so the focus stays put: it closes when it loses it, or on Esc.
    It is built from data the app gathered in the background, and rebuilt only when that changed."""

    GAP = 6       # between the panel and the cards
    MARGIN = 8    # kept free at the screen edges
    PAD = 14      # see-through room around the cards
    SIDE = 12     # between two menus
    SPACE = 10    # between two cards
    WIDTHS = {"account": 365, "projects": 555, "extras": 350}  # menus beside, for a 434px column

    def __init__(self, app):
        super().__init__(title="Claude Accounts")
        self.app = app
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_icon_name("claude-accounts")
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        self.round = bool(visual and screen.is_composited())  # glass needs a see-through window
        if self.round:
            self.set_visual(visual)
        self.set_app_paintable(True)
        styled(self, "ct-window")
        self.root = styled(Gtk.Box(spacing=self.SIDE), "ct-root")
        self.root.set_border_width(self.PAD)
        self.root.connect("draw", self.draw_glass)
        self.root.connect_after("size-allocate", lambda *_: GLib.idle_add(self.shape))
        # The see-through window covers the screen while open and never moves: a menu opening only
        # moves the cards within it, so nothing jumps or flickers under the pointer.
        self.stage = Gtk.Fixed()
        self.stage.put(self.root, 0, 0)
        self.stage.show_all()
        self.add(self.stage)
        self.wa = None
        self.levels, self.sig, self.anchor, self.columns, self.hidden_at = [], None, None, 2, 0
        self.one, self.cap, self.cap_sub, self.side, self.origin = 434, 800, 800, "left", (0, 0)
        self.backdrop = self.hot = None
        self.depth, self.kind, self.collect, self.tiles = 0, "card", [], []
        self.connect("delete-event", lambda *_: self.hide() or True)
        self.connect("focus-out-event", lambda *_: self.hide())
        self.connect("key-press-event", self.key)
        self.connect("hide", self.hidden)

    # ----- showing -----

    def toggle(self, anchor=None, t=0):
        if self.get_visible():
            return self.hide()
        if time.time() - self.hidden_at < 0.4:
            return  # the click on the icon took the focus away, which already closed it
        self.popup(anchor, t)

    def popup(self, anchor=None, t=0):
        """Open the dashboard by the panel icon (or the pointer): two columns, or one where the screen
        is too narrow. Its menus open on the side with more room."""
        self.anchor = anchor or pointer_anchor()
        wa = self.wa = Gdk.Display.get_default().get_monitor_at_point(*self.anchor[:2]).get_workarea()
        self.backdrop = grab_backdrop() if self.round and not self.get_visible() else self.backdrop
        TINT[3] = 0.8 if self.backdrop else 1
        ctx = self.get_pango_context()
        cw = ctx.get_metrics(ctx.get_font_description(), None).get_approximate_char_width() / Pango.SCALE
        self.one = int(max(48 * cw, 434))
        self.columns = 2 if wa.width - 2 * (self.MARGIN + self.PAD) >= 2 * self.one + self.SPACE else 1
        self.cap = wa.height - 2 * (self.MARGIN + self.PAD)
        self.close(0, place=False)
        self.render(force=True)
        main = self.levels[0].view
        mw, mh = main.get_preferred_width()[1], main.get_preferred_height()[1]
        self.cap_sub = min(max(mh, 400), self.cap)  # a menu beside is as tall as the dashboard at most
        ax, ay, side = self.anchor
        x = {"left": ax + self.GAP, "right": ax - mw - self.GAP}.get(side, ax - mw // 2)
        y = {"bottom": ay - mh - self.GAP, "top": ay + self.GAP}.get(side, ay)
        lo, hi = wa.x + self.MARGIN, wa.x + wa.width - self.MARGIN
        x = max(lo, min(x, hi - mw))
        y = max(wa.y + self.MARGIN, min(y, wa.y + wa.height - self.MARGIN - mh))
        self.side = "left" if x - lo >= hi - (x + mw) else "right"
        if side not in ("left", "right"):  # a top or bottom panel: slide away from the menus, still by the icon
            x = min(hi - mw, ax - 24) if self.side == "left" else max(lo, ax + 24 - mw)
        self.origin = (x, y)
        self.place()
        self.realize()
        if GdkX11 and isinstance(self.get_window(), GdkX11.X11Window):
            # The latest time, not the click's: with an older one (the panel's own, or none when launched
            # again) the window manager may keep it under the focused window, and it could not close on
            # focus loss.
            t = GdkX11.x11_get_server_time(self.get_window())
        self.show()
        self.present_with_time(t or Gtk.get_current_event_time())
        self.get_window().raise_()

    def place(self):
        """Size the window to what is open, keeping the dashboard itself where it opened."""
        if not self.levels:
            return
        self.root.set_size_request(-1, -1)  # measured afresh: it may have shrunk
        w, h = self.root.get_preferred_width()[1], self.root.get_preferred_height()[1]
        self.root.set_size_request(w, h)  # the stage would give it only its minimum, a sliver of each menu
        beside = w - 2 * self.PAD - self.levels[0].view.get_preferred_width()[1]
        x, y = self.origin
        x -= self.PAD + (beside if self.side == "left" else 0)
        if self.round:  # the window stays over the work area; the cards move in it
            wa = self.wa
            self.stage.move(self.root, max(0, min(x - wa.x, wa.width - w)), max(0, min(y - self.PAD - wa.y, wa.height - h)))
            self.set_size_request(wa.width, wa.height)
            self.resize(wa.width, wa.height)
            self.move(wa.x, wa.y)
            return
        self.set_size_request(w, h)
        self.resize(w, h)
        self.move(x, y - self.PAD)
        # once it has shrunk: the move may have been kept on the screen at the old, wider size
        GLib.timeout_add(80, lambda: self.get_visible() and self.get_size()[0] == w and self.move(x, y - self.PAD))

    def shape(self):
        """Clicks on the see-through room around the menus reach what is behind (and so close this)."""
        win = self.get_window()
        if win and self.round:
            region = cairo.Region()
            for lv in self.levels:
                p = lv.view.translate_coordinates(self, 0, 0) if lv.own else None
                if p:
                    region.union(cairo.RectangleInt(p[0], p[1], lv.view.get_allocated_width(),
                                                    lv.view.get_allocated_height()))
            win.input_shape_combine_region(region, 0, 0)
        return False

    def draw_glass(self, w, cr):
        """The glass under the cards: the blurred screen tinted with the theme's menu colour, a lighter
        tile with a sheen and an edge over it. Settings is one pane of it, its cards
        tiles on that."""
        win = self.get_window()
        if not win:
            return False
        if not self.round:  # no see-through window: a plain background
            cr.set_source_rgb(*TINT[:3])
            cr.paint()
        _, ox, oy = win.get_origin()
        rx, ry = w.translate_coordinates(self, 0, 0)
        ox, oy = ox + rx, oy + ry  # where this is on the screen
        boxes = []
        for lv in self.levels:
            if not lv.view.get_mapped():
                continue
            vx, vy = lv.view.translate_coordinates(w, 0, 0)
            view = (vx, vy, lv.view.get_allocated_width(), lv.view.get_allocated_height())
            for t in lv.tiles:
                p = t.translate_coordinates(w, 0, 0) if t.get_mapped() else None
                if p:
                    boxes.append(((p[0], p[1], t.get_allocated_width(), t.get_allocated_height(), 12), t.glass, view))
        boxes.sort(key=lambda b: b[1] != "panel")  # a pane before the cards on it
        for box, kind, (vx, vy, vw, vh) in boxes:
            cr.save()
            cr.rectangle(vx, vy, vw, vh)
            cr.clip()
            if kind != "inner":  # over the screen: the blurred screen, tinted
                cr.save()
                rounded(cr, *box)
                cr.clip()
                if self.backdrop:
                    cr.set_source_surface(self.backdrop, -ox, -oy)
                    cr.paint()
                cr.set_source_rgba(*TINT)
                cr.paint()
                cr.restore()
            tile(cr, *box, (1, 1, 1, 0 if kind == "panel" else 0.07))
            cr.restore()
        return False

    def key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.close(len(self.levels) - 1) if len(self.levels) > 1 else self.hide()
            return True
        return False

    def hidden(self, *_):
        self.hidden_at = time.time()
        self.close(1, place=False)

    def hide_for_dialog(self):
        """Dialogs can't sit under a window that closes when it loses focus: close it first."""
        self.hide()

    # ----- the cascade -----

    def render(self, force=False):
        """Build what is open; rebuild it only when what it shows changed."""
        if not (force or self.get_visible()):
            return
        keys = [lv.key for lv in self.levels] or [("home",)]
        sig = self.app.signature(keys, self.columns)
        if sig == self.sig and not force:
            return
        scroll = [lv.view.get_vadjustment().get_value() if lv.own else 0 for lv in self.levels]
        self.close(0, place=False)
        for d, k in enumerate(keys):
            if not self.add_level(d, k):
                break
        for lv, v in zip(self.levels, scroll):
            if v and lv.own:
                GLib.idle_add(lambda a=lv.view.get_vadjustment(), v=v: a.set_value(v) and False,
                              priority=GLib.PRIORITY_LOW)
        self.settled()

    def settled(self):
        self.sig = self.app.signature([lv.key for lv in self.levels], self.columns)
        self.mark()
        if self.get_visible():
            self.place()

    def open(self, depth, key):
        if len(self.levels) > depth and self.levels[depth].key == key:
            return
        self.close(depth, place=False)
        self.add_level(depth, key)
        self.settled()

    def close(self, depth, place=True):
        if len(self.levels) <= depth:
            return
        for lv in reversed(self.levels[depth:]):
            lv.widget.destroy()
            if lv.key[0] == "settings" and depth:
                self.accounts.show()
        del self.levels[depth:]
        if place:
            self.settled()

    def add_level(self, depth, key):
        self.depth, self.kind, self.collect, self.tiles = depth, "card", [], []
        body = getattr(self, "menu_" + key[0])(*key[1:])
        if body is None:  # nothing to show (an account that is gone)
            return None
        if key[0] == "settings":  # over the accounts, as tall as the dashboard
            main = self.levels[0].view
            body.set_size_request(self.one, max(main.get_preferred_height()[1], body.get_preferred_height()[1]))
            self.accounts.hide()
            self.slot.pack_start(body, True, True, 0)
            body.show_all()
            lv = Level(key, body, main, False, self.collect, self.tiles)
        else:
            sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=True,
                                    propagate_natural_width=True, valign=Gtk.Align.START)
            sc.set_max_content_height(self.cap_sub if depth else self.cap)
            if depth:  # as wide as it was, or narrower where the screen ends: the dashboard never moves
                width = min(int(self.WIDTHS[key[0]] * self.one / 434), self.room())
                body.set_size_request(width, -1)
                sc.set_max_content_width(width)
            sc.add(body)
            self.root.pack_start(sc, False, False, 0)
            if depth and self.side == "left":
                self.root.reorder_child(sc, 0)
            sc.show_all()
            lv = Level(key, sc, sc, True, self.collect, self.tiles)
        self.levels.append(lv)
        return lv

    def room(self):
        """The width left for one more menu beside, between those open and the screen's edge."""
        if not self.wa:
            return 10 ** 4
        x, wa = self.origin[0], self.wa
        free = x - wa.x if self.side == "left" else wa.x + wa.width - x - self.levels[0].view.get_preferred_width()[1]
        used = sum(lv.view.get_preferred_width()[1] + self.SIDE for lv in self.levels[1:] if lv.own)
        return max(240, free - used - self.SIDE - self.MARGIN)

    def mark(self):
        """Keep the item whose menu is open highlighted, as a menu does while its submenu shows."""
        for d, lv in enumerate(self.levels):
            nxt = self.levels[d + 1].key if d + 1 < len(self.levels) else None
            for it in lv.items:
                ctx = it.get_style_context()
                ctx.add_class("ct-open") if it.opens is not None and it.opens == nxt else ctx.remove_class("ct-open")

    def entered(self, it, _ev):
        """Pointing at an item opens its menu after a moment, and pointing at another one of the same
        menu closes the menus beyond it, as in a menu."""
        self.hot = it
        if it.opens is not None or len(self.levels) > it.depth + 1:
            GLib.timeout_add(250, self.pointed, it)
        return False

    def left(self, it, _ev):
        if self.hot is it:
            self.hot = None
        return False

    def pointed(self, it):
        if self.hot is it and it.get_mapped():
            self.open(it.depth + 1, it.opens) if it.opens is not None else self.close(it.depth + 1)
        return False

    # ----- building blocks -----

    def item(self, child, cb=None, opens=None, whole=False, tip=None):
        """Something to click: a row of a card, or a whole card. opens: the menu it opens."""
        b = Gtk.Button()
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.add(child)
        styled(b, "ct-item", "ct-whole" if whole else None)
        b.depth, b.opens = self.depth, opens
        if opens is not None:
            b.connect("clicked", lambda *_: self.open(b.depth + 1, opens))
        elif cb:
            b.connect("clicked", lambda *_: cb())
        b.connect("enter-notify-event", self.entered)
        b.connect("leave-notify-event", self.left)
        if tip:
            b.set_tooltip_text(tip)
        if whole:
            b.glass = self.kind
            self.tiles.append(b)
        self.collect.append(b)
        return b

    def card(self, *children, rows=False, spacing=12):
        """A card, on its own piece of glass. A card of rows (menu items) has them reach its edges."""
        inner = vbox(*children, spacing=0 if rows else spacing)
        pad(inner, *((4, 0, 4, 0) if rows else (16, 16, 16, 16)))
        c = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        c.pack_start(inner, True, True, 0)
        c.glass = self.kind
        self.tiles.append(c)
        return c

    def caption(self, text, note=None, rows=True):
        """A card's small heading; greyed in the menus beside, like a menu's headings."""
        b = Gtk.Box()
        b.pack_start(lbl(text, "ct-caption", "ct-off" if self.depth else None), True, True, 0)
        if note:
            b.pack_end(lbl(note, "ct-caption", "ct-dim"), False, False, 0)
        return pad(b, 14, 16, 6, 32 if self.depth else 16) if rows else b

    def row(self, icon_name, title, cb=None, sub=None, tone=None, opens=None, end=()):
        """A menu item: an icon badge, a title and a smaller line under it. In the menus beside, which
        open theirs outwards, the arrow of one that opens a menu is on that side; in the dashboard, right."""
        box = Gtk.Box(spacing=12)
        if self.depth:
            slot = arrow(self.side) if opens is not None else Gtk.Box()
            slot.set_size_request(12, -1)
            box.pack_start(slot, False, False, 0)
        box.pack_start(icon(icon_name, "ct-icon", f"ct-{tone}" if tone else None), False, False, 0)
        box.pack_start(two_lines(title, sub, tone) if sub else lbl(title, f"ct-{tone}" if tone else None), True, True, 0)
        for e in end:
            box.pack_end(e, False, False, 0)
        if opens is not None and not self.depth:
            box.pack_end(arrow("right"), False, False, 0)
        v = 17 if sub else 10 if self.depth else 9
        pad(box, v, 12, v, 0 if self.depth else 8)
        return self.item(box, cb, opens)

    def tone(self, name, now):
        """An account's colour: its 5-hour use, grey when stale or logged out, blue while logging in."""
        a = self.app
        u, ident = a.snap["use"].get(name), a.ids.get(name)
        w5 = window(u, "session", now)
        if a.login and a.login.name == name:
            return "blue"
        stale = not u or now - u.get("updated", 0) > STALE
        return "grey" if (ident is not None and "error" in ident) or stale or not w5 else tone_for(w5["pct"])

    # ----- the dashboard: accounts left; today, best account, running sessions, actions right -----

    def menu_home(self):
        a, s, now = self.app, self.app.snap, time.time()
        self.accounts = vbox(*(self.account_card(n, now) for n in s["names"]), spacing=self.SPACE)
        self.slot = vbox(self.accounts, spacing=0)
        right = vbox(self.today_card(), spacing=self.SPACE)
        best = best_account(s["names"], s["use"], a.ids, now)
        if best:
            right.pack_start(self.best_card(best, now), False, False, 0)
        right.pack_start(self.running_card(), False, False, 0)
        right.pack_start(self.actions_card(), False, False, 0)
        if self.columns == 2:
            self.slot.set_size_request(self.one, -1)
            right.set_size_request(self.one, -1)
            return hbox(self.slot, right, spacing=self.SPACE)
        body = vbox(self.slot, right, spacing=self.SPACE)
        body.set_size_request(self.one, -1)
        return body

    def account_card(self, name, now):
        a = self.app
        u, ident = a.snap["use"].get(name), a.ids.get(name)
        used = last_used(u)
        dim = not u or now - u.get("updated", 0) > STALE
        logged_out = (ident or {}).get("error") == "not logged in"  # not a check that failed
        top = Gtk.Box(spacing=8)
        top.pack_start(lbl(name, "ct-title"), False, False, 0)
        if (ident or {}).get("plan"):
