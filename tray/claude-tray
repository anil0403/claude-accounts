def styled(w, *classes):
    for c in classes:
        if c:
            w.get_style_context().add_class(c)
    return w


def lbl(text, *classes, markup=False, xalign=0.0, wrap=False):
    lb = Gtk.Label(xalign=xalign)
    lb.set_markup(text) if markup else lb.set_text(str(text))
    if wrap:
        lb.set_line_wrap(True)
        lb.set_max_width_chars(30)  # the natural width; the menu's width decides the real one
    else:
        lb.set_ellipsize(Pango.EllipsizeMode.END)
    return styled(lb, *classes)


def icon(name, *classes, size=None):
    img = Gtk.Image.new_from_icon_name(name, Gtk.IconSize.MENU)
    if size:
        img.set_pixel_size(size)
    img.set_valign(Gtk.Align.CENTER)
    return styled(img, *classes)


