class PanelIcon:
    """The panel icon, through whatever the panel speaks: XApp's status icon (Cinnamon, MATE, Xfce),
    an AppIndicator (KDE, GNOME with the AppIndicator extension, ...) or GTK's tray icon (other X11
    panels). XApp and GTK report clicks, so the dashboard toggles; an AppIndicator only shows a
    menu, so that menu opens it (a middle click does too)."""

    SIDES = {Gtk.PositionType.TOP: "top", Gtk.PositionType.BOTTOM: "bottom",
             Gtk.PositionType.LEFT: "left", Gtk.PositionType.RIGHT: "right"}

    def __init__(self, app):
        self.app = app
        desk = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
        if XApp and (any(d in desk for d in ("cinnamon", "mate", "xfce")) or not Indicator):
            self.kind = "xapp"
            self.icon = XApp.StatusIcon()
            self.icon.set_name("claude-tray")
            self.icon.connect("button-release-event", self.xapp_clicked)
        elif Indicator:
            self.kind = "indicator"
            self.icon = Indicator.Indicator.new("claude-accounts", "claude-accounts",
                                                Indicator.IndicatorCategory.APPLICATION_STATUS)
            self.icon.set_status(Indicator.IndicatorStatus.ACTIVE)
            self.icon.set_title("Claude Accounts")
            menu = Gtk.Menu()
            for text, cb in (("Open Claude Accounts", lambda: app.dash.popup()), ("Refresh now", app.refresh_now),
                             (None, None), ("Quit", app.quit)):
                it = Gtk.SeparatorMenuItem() if text is None else Gtk.MenuItem(label=text)
                if cb:
                    it.connect("activate", lambda _it, cb=cb: cb())
                menu.append(it)
            menu.show_all()
            self.icon.set_menu(menu)
            self.icon.set_secondary_activate_target(menu.get_children()[0])
            self.menu = menu  # the indicator keeps no reference of its own
        else:
            self.kind = "gtk"
            self.icon = Gtk.StatusIcon()
            self.icon.set_title("Claude Accounts")
            self.icon.connect("activate", lambda *_: app.dash.toggle(self.gtk_anchor()))
            self.icon.connect("popup-menu", lambda *_: app.dash.toggle(self.gtk_anchor()))

    def xapp_clicked(self, icon, x, y, button, t, position):
        if button in (Gdk.BUTTON_PRIMARY, Gdk.BUTTON_SECONDARY):
            size = icon.get_icon_size() or 24
            side = self.SIDES.get(position, "bottom")
            self.app.dash.toggle((x + size // 2, y, side) if side in ("top", "bottom") else (x, y, side), t)

    def gtk_anchor(self):
        ok, _screen, area, _orient = self.icon.get_geometry()
        if not ok:
            return None
        mon = Gdk.Display.get_default().get_monitor_at_point(area.x, area.y).get_geometry()
        cx = area.x + area.width // 2
        return (cx, area.y, "bottom") if area.y > mon.y + mon.height // 2 else (cx, area.y + area.height, "top")

    def update(self, path, text, tip):
        if self.kind == "xapp":
            self.icon.set_icon_name(path)
            self.icon.set_label(text)
            self.icon.set_tooltip_text(tip)
        elif self.kind == "indicator":
            self.icon.set_icon_full(path, "Claude usage")
            self.icon.set_label(text, "")
        else:
            self.icon.set_from_file(path)
            self.icon.set_tooltip_text(tip)

    def shows_text(self):
        return self.kind != "gtk"


def pointer_anchor():
    _screen, x, y = Gdk.Display.get_default().get_default_seat().get_pointer().get_position()
    mon = Gdk.Display.get_default().get_monitor_at_point(x, y).get_geometry()
    return x, y, "bottom" if y > mon.y + mon.height // 2 else "top"


# ---------- dashboard ----------

class Dashboard(Gtk.Window):
    """The window the panel icon opens. Pages slide in a Gtk.Stack: home, an account, settings,
    plugins and skills. It is built from data the app gathered in the background, and rebuilt only
    while it is open and only when what it shows changed. It closes when it loses focus or on Esc."""

    GAP = 6       # between the panel and the window
    MARGIN = 8    # kept free at the screen edges

    def __init__(self, app):
        super().__init__(title="Claude Accounts")
        self.app = app
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_icon_name("claude-accounts")
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        self.round = bool(visual and screen.is_composited())  # rounded corners need see-through ones
        if self.round:
            self.set_visual(visual)
            self.set_app_paintable(True)
        styled(self, "ct-window")
        self.panel = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL), "ct-panel", None if self.round else "ct-square")
        self.stack = Gtk.Stack(vhomogeneous=False, transition_duration=160)
        self.stack.connect("notify::transition-running", self.prune)
        self.panel.pack_start(self.stack, True, True, 0)
        self.add(self.panel)
        self.page, self.sig, self.anchor, self.columns, self.hidden_at, self.count = ("home",), None, None, 1, 0, 0
        self.connect("delete-event", lambda *_: self.hide() or True)
        self.connect("focus-out-event", lambda *_: self.hide())
        self.connect("key-press-event", self.key)
        self.connect("hide", lambda *_: setattr(self, "hidden_at", time.time()))

    # ----- showing -----

    def toggle(self, anchor=None, t=0):
        if self.get_visible():
            return self.hide()
        if time.time() - self.hidden_at < 0.4:
            return  # the click on the icon took the focus away, which already closed it
        self.popup(anchor, t)

    def popup(self, anchor=None, t=0):
        """Open on the home page next to the panel icon (or the pointer), sized to fit the screen:
        one column, or two when one would need scrolling and the screen is wide enough."""
        self.anchor = anchor or pointer_anchor()
        wa = Gdk.Display.get_default().get_monitor_at_point(*self.anchor[:2]).get_workarea()
        ctx = self.get_pango_context()
        cw = ctx.get_metrics(ctx.get_font_description(), None).get_approximate_char_width() / Pango.SCALE
        one = int(min(max(44 * cw, 380), wa.width - 2 * self.MARGIN))
        self.page, self.columns = ("home",), 1
        self.render(force=True)
        maxh = wa.height - 2 * self.MARGIN
        w = one
        if self.height(one) > maxh and wa.width - 2 * self.MARGIN >= 2 * one:
            self.columns, w = 2, 2 * one
            self.render(force=True)
        h = min(self.height(w), maxh)
        for sc in self.scrollers():
            sc.set_max_content_height(maxh)
        self.set_size_request(w, h)
        self.resize(w, h)
        ax, ay, side = self.anchor
        x = {"left": ax + self.GAP, "right": ax - w - self.GAP}.get(side, ax - w // 2)
        y = {"bottom": ay - h - self.GAP, "top": ay + self.GAP}.get(side, ay)
        self.move(max(wa.x + self.MARGIN, min(x, wa.x + wa.width - w - self.MARGIN)),
                  max(wa.y + self.MARGIN, min(y, wa.y + wa.height - h - self.MARGIN)))
        self.realize()
        if not t and GdkX11 and isinstance(self.get_window(), GdkX11.X11Window):
            # Not opened by a click (launched again, or from the indicator's menu): without a recent
            # timestamp the window manager would not focus it, and it could not close on focus loss.
            t = GdkX11.x11_get_server_time(self.get_window())
        self.show()
        self.present_with_time(t or Gtk.get_current_event_time())

    def height(self, width):
        self.panel.show_all()
        return self.panel.get_preferred_height_for_width(width)[1]

    def scrollers(self):
        return [c.scroller for c in self.stack.get_children() if hasattr(c, "scroller")]

    def key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.go(("home",), back=True) if self.page != ("home",) else self.hide()
            return True
        return False

    def hide_for_dialog(self):
        """Dialogs can't sit under a window that closes when it loses focus: close it first."""
        self.hide()

    # ----- pages -----

    def go(self, page, back=False):
        self.page = page
        self.render(force=True, transition=Gtk.StackTransitionType.SLIDE_RIGHT if back else
                    Gtk.StackTransitionType.SLIDE_LEFT)

    def render(self, force=False, transition=Gtk.StackTransitionType.NONE):
        """Show the current page; rebuild it only when what it shows changed (or a new page)."""
        if not (force or self.get_visible()):
            return
        sig = self.app.signature(self.page, self.columns)
        if sig == self.sig and not force:
            return
        self.sig = sig
        old = self.stack.get_visible_child()
        keep = old.scroller.get_vadjustment().get_value() if old is not None and old.page == self.page else 0
        builder = {"home": self.home, "account": self.account, "settings": self.settings_page,
                   "extras": self.extras}[self.page[0]]
        content = builder(*self.page[1:])
        if content is None:  # e.g. the account is gone
            self.page = ("home",)
            content = self.home()
        head, body = content
        sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=True)
        if old is not None and hasattr(old, "scroller"):
            sc.set_max_content_height(old.scroller.get_max_content_height())
        sc.add(styled(body, "ct-body"))
        page = vbox(styled(head, "ct-head"), spacing=0)
        page.pack_start(sc, True, True, 0)
        page.scroller, page.page = sc, self.page
        self.count += 1
        self.stack.add_named(page, f"p{self.count}")
        page.show_all()
        self.stack.set_visible_child_full(f"p{self.count}", transition)
        if keep:
            GLib.idle_add(lambda: sc.get_vadjustment().set_value(keep) and False, priority=GLib.PRIORITY_LOW)
        if transition == Gtk.StackTransitionType.NONE:
            self.prune()

    def prune(self, *_):
        if not self.stack.get_transition_running():
            for c in self.stack.get_children():
                if c is not self.stack.get_visible_child():
                    self.stack.remove(c)

    def header(self, title, sub=None, back=True, tools=()):
        h = Gtk.Box(spacing=6)
        if back:
            h.pack_start(tool("go-previous-symbolic", lambda: self.go(("home",), back=True), "Back (Esc)"), False, False, 0)
        t = vbox(lbl(title, "ct-app"), spacing=1)
        if sub:
            t.pack_start(lbl(sub, "ct-small", "ct-dim"), False, False, 0)
        h.pack_start(t, True, True, 0)
        for t in tools:
            h.pack_end(t, False, False, 0)
        return h

    # home: accounts, today, best account, running sessions, actions

    def home(self):
        a, s, now = self.app, self.app.snap, time.time()
        names = s["names"]
        head = self.header("Claude Accounts", plural(len(names), "account"), back=False, tools=(
            tool("emblem-system-symbolic", lambda: self.go(("settings",)), "Settings"),
            tool("view-refresh-symbolic", a.refresh_now, "Refresh now")))
        left = vbox(*(self.account_card(n, now) for n in names))
        right = vbox()
        if a.login:
            show, cancel = Gtk.Button(label="Show login window"), Gtk.Button(label="Cancel login")
            show.connect("clicked", lambda *_: a.login and (self.hide(), a.login.present()))
            cancel.connect("clicked", lambda *_: a.login and a.login.cancel())
            right.pack_start(styled(vbox(lbl(f"Waiting for the browser login of {a.login.name}…", wrap=True),
                                         hbox(show, cancel, spacing=6), spacing=8), "ct-banner", "ct-blue"),
                             False, False, 0)
        elif a.note:
            right.pack_start(styled(lbl(a.note[0], wrap=True), "ct-banner", "ct-amber" if a.note[1] else "ct-green"),
                             False, False, 0)
        right.pack_start(self.today_card(), False, False, 0)
        best = best_account(names, s["use"], a.ids, now)
        if best:
            right.pack_start(self.best_card(best, now), False, False, 0)
        right.pack_start(self.running_card(), False, False, 0)
        right.pack_start(card(
            row("list-add-symbolic", "Add account…", a.add_account, "Log in to another Claude account"),
            row("application-x-addon-symbolic", "Plugins and skills",
                lambda: self.go(("extras",)), f"{plural(len(s['plugins']), 'plugin')}, {plural(len(s['skills']), 'skill')}, shared by all accounts"),
            row("web-browser-symbolic", "Usage on claude.ai", lambda: a.xdg_open(USAGE_PAGE)),
            row("system-shutdown-symbolic", "Quit", a.quit, tone="red"), spacing=2), False, False, 0)
        if self.columns == 2:
            body = Gtk.Box(spacing=12, homogeneous=True)
            body.pack_start(left, True, True, 0)
            body.pack_start(right, True, True, 0)
        else:
            body = vbox(left, right)
        return head, body

    def account_card(self, name, now):
        a = self.app
        u, ident = a.snap["use"].get(name), a.ids.get(name)
        used = last_used(u)
        dim = not u or now - u.get("updated", 0) > STALE
        logged_out = ident is not None and "error" in ident
        top = Gtk.Box(spacing=8)
        top.pack_start(lbl(name, "ct-title"), False, False, 0)
        if (ident or {}).get("plan"):
            top.pack_start(pill(ident["plan"], plan_tone(ident["plan"])), False, False, 0)
        if a.login and a.login.name == name:
            top.pack_end(pill("Logging in…", "blue"), False, False, 0)
        elif logged_out:
            top.pack_end(pill("Not logged in", "amber"), False, False, 0)
        elif used and now - used < 180:
            top.pack_end(pill("Active now", "blue"), False, False, 0)
        elif used:
            top.pack_end(lbl(f"used {ago(used, now)}", "ct-small", "ct-dim"), False, False, 0)
        head = vbox(top, spacing=2)
        if ident and "email" in ident:
            head.pack_start(lbl(a.email(ident["email"]), "ct-small", "ct-dim"), False, False, 0)
        box = vbox(head, spacing=12)
        meters = [Meter(c, w, n, now, dim) for c, k, n in (("5-HOUR", "session", SESSION_LEN), ("WEEKLY", "weekly", WEEK_LEN))
                  if (w := window(u, k, now))]
        for m in meters:
            box.pack_start(m, False, False, 0)
        if not meters and not logged_out:
            box.pack_start(lbl("No usage yet: open it and send a message.", "ct-small", "ct-dim"), False, False, 0)
        note = a.api_note(name, u, now)
        if note:
            box.pack_start(lbl(note, "ct-small", "ct-amber", wrap=True), False, False, 0)
        return button(box, lambda: self.go(("account", name)), "ct-card", tip=f"Sessions and projects with {name}")

    def today_card(self):
        t = self.app.today
        if not t:
            return card(caption("TODAY"), lbl("Reading today's sessions…", "ct-small", "ct-dim"))
        top = Gtk.Box(spacing=8)
        top.pack_start(lbl("TODAY", "ct-caption"), True, True, 0)
        cost = lbl(f"${t['cost']:.2f}", "ct-big", "ct-green", xalign=1)
        cost.set_tooltip_text("What today's use would cost at API prices, all accounts")
        top.pack_end(cost, False, False, 0)
        stats = Gtk.Box(homogeneous=True, spacing=6)
        for v, k in ((t["turns"], "prompts"), (active_text(t["active"]), "active"), (t["lines"], "lines written")):
            stats.pack_start(vbox(lbl(v, "ct-pct", xalign=0.5), lbl(k, "ct-small", "ct-dim", xalign=0.5), spacing=2),
                             True, True, 0)
        c = card(top, stats, spacing=12)
        models = sorted(t["replies"].items(), key=lambda kv: -kv[1])
        if models:
